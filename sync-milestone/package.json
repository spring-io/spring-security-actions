{
  "name": "sync-milestone",
  "version": "0.0.1",
  "private": true,
  "description": "Keeps the milestones of a release in step with its release train: joins and leaves the train, sets the due dates and the descriptions",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "format": "prettier --write 'src/**/*.js' 'test/**/*.js'",
    "check": "prettier --check 'src/**/*.js' 'test/**/*.js'",
    "compile": "ncc build src/index.js --out dist --no-source-map-register",
    "build": "npm run format && npm run compile",
    "test": "vitest run"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@octokit/rest": "^22.0.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@vercel/ncc": "0.45.0",
    "prettier": "3.9.10",
    "vitest": "^5.0.0"
  }
}
